$dialog show @s {\
    type:"minecraft:multi_action",\
    title:"Survival Rebalanced Settings",\
    external_title:"Survival Rebalanced",\
    body:[],\
    inputs:[\
        {\
            type:"minecraft:single_option",\
            key:"regeneration_rework_value",\
            width:150,\
            label:"Regeneration rework",\
            label_visible:1,\
            options:[\
                {\
                    id:"false",\
                    display:"OFF",\
                    initial:0\
                },\
                {\
                    id:"true",\
                    display:"ON",\
                    initial:$(regeneration_rework)\
                }\
            ]\
        },\
        {\
            type:"minecraft:single_option",\
            key:"hunger_system_changes_value",\
            width:150,\
            label:"Hunger changes",\
            label_visible:1,\
            options:[\
                {\
                    id:"false",\
                    display:"OFF",\
                    initial:0\
                },\
                {\
                    id:"true",\
                    display:"ON",\
                    initial:$(hunger_system_changes)\
                }\
            ]\
        },\
        {\
            type:"minecraft:single_option",\
            key:"mob_buffs",\
            width:150,\
            label:"Mob buffs",\
            label_visible:1,\
            options:[\
                {\
                    id:"false",\
                    display:"OFF",\
                    initial:0\
                },\
                {\
                    id:"true",\
                    display:"ON",\
                    initial:$(mob_buffs)\
                }\
            ]\
        },\
        {\
            type:"minecraft:single_option",\
            key:"flammable_creepers_value",\
            width:150,\
            label:"Flammable creepers",\
            label_visible:1,\
            options:[\
                {\
                    id:"false",\
                    display:"OFF",\
                    initial:0\
                },\
                {\
                    id:"true",\
                    display:"ON",\
                    initial:$(flammable_creepers)\
                }\
            ]\
        },\
        {\
            type:"minecraft:single_option",\
            key:"dolphin_jockeys_value",\
            width:150,\
            label:"Dolphin jockeys",\
            label_visible:1,\
            options:[\
                {\
                    id:"false",\
                    display:"OFF",\
                    initial:0\
                },\
                {\
                    id:"true",\
                    display:"ON",\
                    initial:$(dolphin_jockeys)\
                }\
            ]\
        },\
        {\
            type:"minecraft:single_option",\
            key:"reduced_item_spread_on_death_value",\
            width:150,\
            label:"Reduced item spread on death",\
            label_visible:1,\
            options:[\
                {\
                    id:"false",\
                    display:"OFF",\
                    initial:0\
                },\
                {\
                    id:"true",\
                    display:"ON",\
                    initial:$(reduced_item_spread_on_death)\
                }\
            ]\
        }\
        ],\
    can_close_with_escape:1,\
    pause:1,\
    after_action:"close",\
    columns:2,\
    actions:[\
        {\
            label:"Cancel",\
            tooltip:"Close menu without saving settings",\
            width:150\
        },\
        {\
            label:"Done",\
            tooltip:"Save settings and close menu",\
            width:150,\
            action:{\
                type:"dynamic/run_command",\
                template:"data merge storage svr:settings {\
                    regeneration_rework:\$(regeneration_rework_value),\
                    mob_buffs:\$(mob_buffs_value),\
                    hunger_system_changes:\$(hunger_system_changes_value),\
                    flammable_creepers:\$(flammable_creepers_value),\
                    dolphin_jockeys:\$(dolphin_jockeys_value),\
                    reduced_item_spread_on_death:\$(reduced_item_spread_on_death_value)\
                    }"\
                }\
            },\
        {\
            label:{\
                text:"About features",\
                type:"text",\
                underlined:1,\
                color:"yellow"\
            },\
            tooltip:"",\
            width:150,\
            action:{\
                type:"show_dialog",\
                dialog:"svr:about_features"\
            }\
        }\
    ]\
}